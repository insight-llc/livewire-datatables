<?xml version="1.0"?>
<ruleset>
    <!--
        The Insight standard, installed by insight-llc/insight-standards and
        registered with PHP_CodeSniffer by the Composer installer. It used to be
        a copy of the ruleset and its sniffs published into every consumer
        repository; it is now a versioned dependency, so a rule change arrives
        as a version bump instead of a file overwrite.
    -->
    <rule ref="Insight" />

    <!--
        The project's PSR-4 roots, for the file-name check. The plugin writes
        this ruleset from composer.json on every composer install and update,
        so this file stays identical to the shipped copy. It comes after the
        Insight standard, so its map replaces the Laravel defaults there.
        Commit it: a run with no scripts skips the plugin, and PHPCS cannot
        load this ruleset without it.
    -->
    <rule ref="./phpcs.namespaces.xml" />

    <!--
        Agent guidance: the project's own guidelines, and the rules Laravel
        Boost generates. It is not application code and has no PSR-4 root, so
        namespace and filename rules can never be satisfied there. Excluded so a
        project lint run never fails on a script or template kept beside them.
    -->
    <exclude-pattern>*/\.ai/*</exclude-pattern>
</ruleset>
