<?xml version="1.0"?>
<ruleset name="Insight Namespaces">
    <!--
        Generated by insight-llc/developer-settings from the PSR-4 roots in
        composer.json, on every composer install and update. Commit it, and do not
        edit it: the next run rewrites it.
    -->
    <rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
        <properties>
            <property name="rootNamespaces" type="array">
                <element key="src" value="Mediconesystems\LivewireDatatables" />
                <element key="tests" value="Mediconesystems\LivewireDatatables\Tests" />
            </property>
        </properties>
    </rule>
</ruleset>
