{
    "name": "insight-llc/livewire-datatables",
    "description": "Advanced datatables using Laravel, Livewire, Tailwind CSS and Alpine JS",
    "keywords": [
        "php",
        "laravel",
        "livewire"
    ],
    "homepage": "https://github.com/insight-llc/livewire-datatables",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mark Salmon",
            "email": "mark.salmon@mediconesystems.com",
            "role": "Developer"
        },
        {
            "name": "Shane Burrell",
            "email": "shane@shaneburrell.com",
            "role": "Developer"
        },
        {
            "name": "Herbert Maschke",
            "email": "thyseus@pm.me",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "no-api": true,
            "url": "git@github.com:insight-llc/developer-settings.git"
        },
        {
            "type": "vcs",
            "no-api": true,
            "url": "git@github.com:insight-llc/insight-standards.git"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^13.0",
        "livewire/livewire": "^4.0",
        "maatwebsite/excel": "^4.0",
        "reedware/laravel-relation-joins": "^9.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "insight-llc/developer-settings": "^0.8",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Mediconesystems\\LivewireDatatables\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mediconesystems\\LivewireDatatables\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "lint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "insight-llc/developer-settings": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mediconesystems\\LivewireDatatables\\LivewireDatatablesServiceProvider"
            ]
        }
    }
}
